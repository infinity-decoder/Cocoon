{
  "name": "react-example",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "tsx --test src/**/*.test.ts",
    "test:unit": "tsx --test src/domain/**/*.test.ts src/core/**/*.test.ts",
    "test:accounting": "tsx --test src/application/services/AccountingCoreAndTransfers.test.ts src/application/services/FinancialCalculationService.test.ts src/application/services/PartyKhataService.test.ts",
    "test:migrations": "tsx --test src/infrastructure/database/migrations/MigrationService.test.ts src/infrastructure/database/migrationRunner.test.ts",
    "test:backups": "tsx --test src/infrastructure/storage/BackupArchiveService.test.ts",
    "test:benchmarks": "tsx --test src/infrastructure/database/benchmarks/highVolumePerformance.test.ts",
    "verify:secrets": "node scripts/scan-secrets.mjs",
    "verify:pipeline": "npm run verify:secrets && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "^8.1.1",
    "@capacitor/android": "^8.5.1",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.1",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/share": "^8.0.3",
    "@capacitor/status-bar": "^8.0.4",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "html2pdf.js": "^0.14.0",
    "jeep-sqlite": "^2.8.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.9.2",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.1",
    "@types/express": "^4.17.21",
    "@types/html2pdf.js": "^0.10.0",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
